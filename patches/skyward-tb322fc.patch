 pub fn power(target: Power) -> Result<()> {
-    set_prop("sys.powerctl", target.command())
+    // Some recovery init implementations ignore sys.powerctl. Fall back to a
+    // direct kernel reboot after syncing; for recovery/fastboot also leave the
+    // matching bootloader control block so the bootloader selects the target.
+    let requested = set_prop("sys.powerctl", target.command());
+    sync_all();
+    #[cfg(target_os = "android")]
+    {
+        match target {
+            Power::Recovery => {
+                let misc = bcb::misc();
+                let _ = bcb::write(&misc, &bcb::Bcb { command: "boot-recovery".into(), args: Vec::new() });
+            }
+            Power::Fastboot => {
+                let misc = bcb::misc();
+                let _ = bcb::write(&misc, &bcb::Bcb { command: "boot-fastboot".into(), args: Vec::new() });
+            }
+            Power::System => {
+                let misc = bcb::misc();
+                let _ = bcb::clear(&misc);
+            }
+            Power::Bootloader | Power::Edl | Power::Off => {}
+        }
+        // Linux reboot(2) constants. Use the raw syscall rather than a
+        // bionic wrapper so this works across NDK/libc crate versions.
+        const SYS_REBOOT_AARCH64: libc::c_long = 142;
+        const LINUX_REBOOT_MAGIC1: libc::c_ulong = 0xfee1_dead;
+        const LINUX_REBOOT_MAGIC2A: libc::c_ulong = 672_274_793;
+        const LINUX_REBOOT_CMD_RESTART: libc::c_ulong = 0x0123_4567;
+        const LINUX_REBOOT_CMD_POWER_OFF: libc::c_ulong = 0x4321_fedc;
+        let cmd = match target {
+            Power::Off => LINUX_REBOOT_CMD_POWER_OFF,
+            _ => LINUX_REBOOT_CMD_RESTART,
+        };
+        // reboot(2) never returns on success. If it fails, preserve the
+        // original property-service error for the caller.
+        let rc = unsafe { libc::syscall(SYS_REBOOT_AARCH64, LINUX_REBOOT_MAGIC1, LINUX_REBOOT_MAGIC2A, cmd, 0usize) };
+        let _ = rc;
+    }
+    requested
+}
+
+/// Flush filesystem data before a direct reboot, as init would before it
+/// acted on sys.powerctl.
+fn sync_all() {
+    #[cfg(target_os = "android")]
+    unsafe {
+        libc::sync();
+    }
 }
 
